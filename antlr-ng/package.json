{
  "name": "@wstein/flix-antlr-ng",
  "version": "0.1.0",
  "description": "Flix ANTLR-NG (TypeScript) grammar target and structural parser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "antlr4ng -Dlanguage=TypeScript -visitor FlixLexer.g4 FlixParser.g4 -o src/generated",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "antlr4ng": "^3.0.0"
  },
  "devDependencies": {
    "antlr4ng-cli": "^3.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
