{
  "name": "@wstein/flix-antlr-ng",
  "version": "0.1.0",
  "description": "Flix antlr-ng (TypeScript) grammar target",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate:experimental": "antlr-ng -o src/generated -D language=TypeScript --generate-visitor --generate-listener false ../grammars/FlixLexer.g4 ../grammars/FlixParser.g4",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "antlr-ng": "^1.0.10",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
