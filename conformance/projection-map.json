{
  "schemaVersion": 1,
  "consumer": "flix-antlr-grammar",
  "description": "Maps this grammar's ANTLR rule names onto flix-spec's canonical TreeKind vocabulary. Written by starting empty and working down the report's frequency-ranked `unmapped` list, which is the workflow flix-spec's docs/CONFORMANCE.md prescribes: map what is genuinely the same node, declare our own wrappers transparent, and leave the rest unmapped rather than guessing -- a wrong mapping reports as agreement and is worse than a gap.",
  "mappings": {
    "AddExpr": "Expr.Binary",
    "AndExpr": "Expr.Binary",
    "AngledPlusExpr": "Expr.Binary",
    "ApplyExpr": "Expr.Apply",
    "AscribePrimary": "Expr.Ascribe",
    "CheckedCastExpr": "Expr.CheckedTypeCast",
    "CheckedEffectCastExpr": "Expr.CheckedEffectCast",
    "CompareExpr": "Expr.Binary",
    "ConsExpr": "Expr.Binary",
    "DiscardExpr": "Expr.Unary",
    "EqualityExpr": "Expr.Binary",
    "ExtTagExpr": "Expr.ExtTag",
    "GetFieldExpr": "Expr.GetField",
    "HolePrimary": "Expr.Hole",
    "InfixCallExpr": "Expr.Binary",
    "InstanceOfExpr": "Expr.Binary",
    "IntrinsicPrimary": "Expr.Intrinsic",
    "InvokeConstructorExpr": "Expr.InvokeConstructor",
    "InvokeMethodExpr": "Expr.InvokeMethod",
    "InvokeSuperConstructorExpr": "Expr.InvokeSuperConstructor",
    "InvokeSuperMethodExpr": "Expr.InvokeSuperMethod",
    "LazyForceExpr": "Expr.Unary",
    "LiteralPrimary": "Expr.Literal",
    "MultExpr": "Expr.Binary",
    "NamedHolePrimary": "Expr.Hole",
    "NotExpr": "Expr.Unary",
    "OrExpr": "Expr.Binary",
    "ParenPrimary": "Expr.Paren",
    "SignExpr": "Expr.Unary",
    "StaticPrimary": "Expr.Static",
    "StringPrimary": "Expr.Literal",
    "TuplePrimary": "Expr.Tuple",
    "UncheckedCastExpr": "Expr.UncheckedCast",
    "UnitPrimary": "Expr.Tuple",
    "UserOpExpr": "Expr.Binary",
    "aliasDeclaration": "Decl.TypeAlias",
    "argumentList": "ArgumentList",
    "assocTypeDeclaration": "Decl.AssociatedTypeSig",
    "associatedTypeDefinition": "Decl.AssociatedTypeDef",
    "block": "Expr.Block",
    "caseBody": "CaseBody",
    "catchRule": "Expr.TryCatchRuleFragment",
    "compilationUnit": "Root",
    "constraint": "Expr.FixpointConstraint",
    "constraintSet": "Expr.FixpointConstraintSet",
    "defDeclaration": "Decl.Def",
    "derivations": "Type.DerivationList",
    "docComment": "DocComment",
    "effDeclaration": "Decl.Effect",
    "enumCase": "Case",
    "enumDeclaration": "Decl.Enum",
    "equalityConstraint": "Decl.EqualityConstraintFragment",
    "extensibleType": "Type.Extensible",
    "formalParam": "Parameter",
    "formalParams": "ParameterList",
    "importClause": "UsesOrImports.Import",
    "importMany": "UsesOrImports.ImportMany",
    "instanceDeclaration": "Decl.Instance",
    "kind": "Kind",
    "lambdaParams": "ParameterList",
    "latticeTerm": "Predicate.LatticeTerm",
    "literalExpression": "Expr.Literal",
    "matchRule": "Expr.MatchRuleFragment",
    "modDeclaration": "Decl.Module",
    "nameLowercase": "Ident",
    "nameMath": "Ident",
    "nameUppercase": "Ident",
    "opDeclaration": "Decl.Op",
    "operator": "Operator",
    "packageName": "UsesOrImports.Package",
    "parFragment": "Expr.ForFragmentGenerator",
    "plainComment": "PlainComment",
    "predicateAlias": "Type.PredicateWithAlias",
    "predicateAndArity": "PredicateAndArity",
    "predicateAtom": "Predicate.Atom",
    "predicateHead": "Predicate.Head",
    "predicateParam": "Predicate.Param",
    "predicateTypes": "Type.PredicateWithTypes",
    "recordOperation": "Expr.RecordOperation",
    "recordPattern": "Pattern.Record",
    "redefDeclaration": "Decl.Redef",
    "restrictableEnumDeclaration": "Decl.RestrictableEnum",
    "schemaRowType": "Type.SchemaRow",
