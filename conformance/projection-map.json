  "flatten": [
    "declPrefix",
    "instanceMember",
    "traitMember",
    "enumDeclarationTail"
  ],
  "notes": {
    "declaration": "A wrapper around every declaration together with its doc, annotations and modifiers, where the reference makes those direct children of Decl.Def. Transparent at arity <= 1 and spliced by `declPrefix` otherwise.",
    "definitionName": "A wrapper around the name rule, where the reference's Ident holds its token directly. Mapping both onto Ident gave Ident-inside-Ident and an arity divergence on every declaration -- 126 of them, the single largest class in the first measurement.",
    "expr": "Emitted only for a bare ExprContext, which ANTLR leaves behind when error recovery abandons a left-recursive alternative before a label is chosen -- the match/ematch missing-body fixtures. Every successful parse emits a label instead. Kept in ignored, with type and pattern, so those recovery nodes stay transparent as they always were.",
    "modifier": "The reference groups modifiers in ModifierList and holds each as a token, with no per-modifier node, so ours is transparent rather than mapped.",
    "nameLowercase": "The reference has one Ident kind and distinguishes case lexically rather than structurally, so all four name rules map onto it.",
    "primaryExpr": "Labelled alternatives preserve literal, Unit, parenthesized and tuple nodes; container alternatives remain transparent.",
    "usesOrImports": "Each source clause remains its own wrapper; projection now groups the prefix clauses under useList. Both the raw useList and canonical UseOrImportList are transparent only at arity zero or one, preserving a real branching list.",
    "operator": "Not a grammar rule: Projection.kt synthesises it for the unary and binary labels, grouping the operator tokens (plus nameMath, and the name between backticks) that the parse tree holds as bare tokens. The reference kinds are Expr.Binary (lhs, Operator, rhs) and Expr.Unary (Operator, operand); without this node every one would diverge on arity, since tokens are never emitted. The grammar keeps its precedence levels, which a shared binaryOp rule would have flattened."
  },
  "elide": [
    "AnnotationList",
    "Expr.Expr",
    "Expr.Statement",
    "ModifierList",
    "Pattern.Pattern",
    "QName",
    "Type.Apply",
    "UsesOrImports.UseOrImportList"
  ]
}
