    "typeArgs": "Type.ArgumentList",
    "typeParam": "Parameter",
    "typeParams": "TypeParameterList",
    "useClause": "UsesOrImports.Use",
    "useList": "UsesOrImports.UseOrImportList",
    "useMany": "UsesOrImports.UseMany",
    "useName": "UsesOrImports.Alias",
    "variableType": "Type.Variable"
  },
  "ignored": [
    "AndType",
    "ApplyType",
    "ArrowType",
    "BlockPrimary",
    "ChooseExpr",
